SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# ── Legion SSO + roster ──────────────────────────────────────────────────────
# /admin is gated by Legion's shared `mw_sso` cookie + the `tempus-admin` group.
# There is no local admin password: grant the first admin `tempus-admin` in Legion's
# /admin/groups. SSO_SECRET must be identical to Legion's; add Tempus's host to Legion's
# SSO_ALLOWED_RETURN_HOSTS or the return_to redirect back to Tempus is rejected.
SSO_SECRET=must-match-legion-sso-secret
SSO_SESSION_TTL=43200
SSO_COOKIE_DOMAIN=

# Legion roster API (read-only source of truth Tempus mirrors from). Must match the
# value Legion has configured as its TEMPUS_API_KEY (Tempus and Munus each have their
# own key on Legion's side — this is Tempus's, not shared with Munus).
LEGION_BASE_URL=https://legion.example.org
LEGION_API_KEY=must-match-legions-tempus-api-key

# Tempus's own public URL — used for absolute links back to /me in Slack messages
# (e.g. the /hours "open my dashboard" link). This host must be in Legion's
# SSO_ALLOWED_RETURN_HOSTS (the same host /admin sign-in already returns to).
BASE_URL=https://tempus.example.org

# SQLite database file path
DATABASE_URL=sqlite+aiosqlite:///./tracker.db

# Daily auto sign-out time in 24h format (HH:MM), local time
AUTO_SIGNOUT_TIME=22:00

# "Wall of Shame" meme: post a lighthearted meme to a channel naming kids who
# forgot to sign out (closed by the nightly auto sign-out job).
# ROAST_ENABLED is the global on/off switch; off by default.
# The bot must have chat:write + files:write scopes and be invited to the channel.
ROAST_ENABLED=false
SLACK_ANNOUNCE_CHANNEL=

# Weekly DM job: day (0=Mon ... 6=Sun) and time (HH:MM), local time
WEEKLY_DM_DAY=6
WEEKLY_DM_TIME=21:00

# Nightly SQLite backup: time (HH:MM) and how many snapshots to retain
BACKUP_TIME=23:30
BACKUP_KEEP=14

# Master switch for automated Slack messages, memes, and scheduled DMs
UPDATES_ENABLED=true

# Kiosk/mentor board access is per-device, not per-network: a display is paired once
# from Admin -> Kiosk Devices and stays trusted until revoked. Nothing to configure here.

# How long the kiosk holds on the mentor board after a mentor badge scan before
# returning to the student board. Any student scan cuts it short.
KIOSK_MENTOR_HOLD_SECONDS=120

# Timezone, e.g. America/New_York
TIMEZONE=America/New_York

# Hours multipliers per session status (1.0 = full hours, 0.5 = 50%, 0.0 = none)
# 'auto' always uses the same multiplier as 'contributor'
CONTRIBUTOR_MULTIPLIER=1.0
PRESENT_MULTIPLIER=0.5
DISTRACTION_MULTIPLIER=0.0

# ── Apple Wallet / Google Wallet passes (optional) ───────────────────────────
# When set, the /badge page and the /qr Slack DM offer "Add to Apple/Google Wallet".
# The pass carries the same kiosk QR, but a wallet pass makes the phone turn its screen
# brightness to full automatically when shown, so the kiosk scanner reads it first try.
# Passes are built and signed entirely in-process — no third-party pass service.
# Leave everything blank to disable (the /wallet/* routes 404). Store the cert/key files
# OUTSIDE the repo (e.g. a mounted secrets/ dir) and point these at absolute paths.
#
# Apple: needs a paid Apple Developer account. Create a Pass Type ID, download its
# certificate, and export it (with its private key) from Keychain Access as a .p12.
# Also download Apple's "Worldwide Developer Relations - G4" intermediate from
# https://www.apple.com/certificateauthority/ (PEM or DER/.cer both work).
APPLE_WALLET_P12_PATH=
APPLE_WALLET_P12_PASSWORD=
APPLE_WALLET_WWDR_PATH=
APPLE_WALLET_PASS_TYPE_ID=pass.org.example.tempus
APPLE_WALLET_TEAM_ID=ABCDE12345
APPLE_WALLET_ORG_NAME=MARS/WARS Robotics
#
# Google: a Google Cloud project with the Google Wallet API enabled, a service-account
# key file (JSON), and your Wallet API issuer ID (developers.google.com/wallet). The
# "Add to Google Wallet" link is a JWT signed locally — Tempus never calls Google's API.
GOOGLE_WALLET_SERVICE_ACCOUNT_PATH=
GOOGLE_WALLET_ISSUER_ID=
